{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "imfluent",
    "version": "0.0.0",
    "description": "Fluent-styled widget library for Dear ImGui",
    "homepage": "https://github.com/lukaasm/fluent",
    "builtin-baseline": "77df67cfff9c12ccfdb52284e07c87c75092f723",
    "dependencies": [
        "imgui"
    ],
    "features": {
        "examples": {
            "description": "Build with examples",
            "dependencies": [
                {
                    "name": "imgui",
                    "features": [
                        "sdl3-binding",
                        "sdlgpu3-binding"
                    ]
                }
            ]
        },
        "test-engine": {
            "description": "Build the gallery with Dear ImGui Test Engine automation: regression tests and an MCP server",
            "dependencies": [
                {
                    "name": "imfluent",
                    "features": [
                        "examples"
                    ]
                },
                {
                    "name": "imgui",
                    "features": [
                        "test-engine"
                    ]
                },
                "nlohmann-json",
                "stb"
            ]
        }
    }
}
